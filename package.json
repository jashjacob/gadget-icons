{
  "name": "gadget-icons",
  "version": "0.4.0",
  "description": "Open-source outline SVG icons for gadgets, hardware, cameras, computers, wearables, and smart-home devices.",
  "type": "module",
  "sideEffects": false,
  "main": "icons.mjs",
  "types": "icons.d.mts",
  "exports": {
    ".": {
      "types": "./icons.d.mts",
      "default": "./icons.mjs"
    },
    "./icons/*": "./icons/*"
  },
  "files": [
    "icons",
    "icons.mjs",
    "icons.d.mts",
    "preview.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "icons",
    "svg",
    "tech",
    "svg-icons",
    "device-icons",
    "hardware-icons",
    "technology-icons",
    "outline-icons",
    "ui-icons",
    "consumer-electronics",
    "icon-library",
    "gadgets",
    "smart-home"
  ],
  "author": "Jash Jacob",
  "license": "MIT",
  "homepage": "https://jashjacob.github.io/gadget-icons/",
  "bugs": {
    "url": "https://github.com/jashjacob/gadget-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jashjacob/gadget-icons.git"
  }
}
